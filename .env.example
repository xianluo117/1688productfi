POSTGRES_DB=product_manager
POSTGRES_USER=product_manager
POSTGRES_PASSWORD=replace-with-a-long-database-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Used only to encrypt AI API keys stored in PostgreSQL. Keep it stable across upgrades.
AI_SECRET_KEY=replace-with-at-least-32-random-characters
# Ingestion tokens are created per user in the administrator interface.
# The previous global INGEST_API_TOKEN is no longer accepted.

# Comma-separated browser origins allowed to call ingestion APIs.
ALLOWED_ORIGINS=https://s.1688.com

# Set true after the reverse proxy provides HTTPS.
COOKIE_SECURE=false

# Similarity worker tuning is configured in the administrator UI.
# The image embedding request template supports placeholders for model,
# image_data_url, image_base64, image_url, and product_id.

# Docker Hub images used by docker-compose.yml.
BACKEND_IMAGE=qingmiaoai/1688productfitt:backend
FRONTEND_IMAGE=qingmiaoai/1688productfitt:frontend

# Bind only to localhost so a future reverse proxy is the public entry point.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=1788
